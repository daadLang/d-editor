<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="daad-ide"
        Arguments=""
        InstallLocation="C:\Program Files\daadLang\ض IDE">
    </Installer>
    <PackageInformation
        PackageName="ض IDE"
        PackageDisplayName="ض IDE"
        PublisherName="CN=daadLang"
        PublisherDisplayName="daadLang"
        Version="0.0.1.0"
        PackageDescription="Minimal IDE for the Daad Arabic programming language">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.daadlang.d-editor"
                Description="Minimal IDE for the Daad Arabic programming language"
                DisplayName="ض IDE"
                ExecutableName="daad-ide"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ض IDE</DisplayName>
            <PublisherDisplayName>daadLang</PublisherDisplayName>
            <Description>Minimal IDE for the Daad Arabic programming language</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="daad-ide.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
