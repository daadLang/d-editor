{
  "name": "daad-ide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Minimal IDE for ض (Ḍād) Arabic Programming Language",
  "scripts": {
    "dev:frontend": "vite",
    "dev": "wails dev",
    "build:frontend": "tsc -b && vite build",
